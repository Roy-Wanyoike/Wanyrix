# Wanyrix environment configuration (copy to .env — .env is git-ignored).
# Everything here is OPTIONAL: the deterministic, local-first core runs with
# no configuration at all. See docs/DEVELOPMENT.md for details.

# SQLite file backing the OPTIONAL durable scan-run sync target
# (POST /api/wanyrix/scan-runs). Relative paths resolve against
# prisma/schema.prisma — the example below points at <repo-root>/db/.
# After changing it: bun run db:push
DATABASE_URL="file:../db/custom.db"

# Canonical base URL for absolute OpenGraph/Twitter image URLs in page
# metadata. Only needed when the dashboard is deployed behind a real domain.
# NEXT_PUBLIC_SITE_URL="https://wanyrix.example.com"
