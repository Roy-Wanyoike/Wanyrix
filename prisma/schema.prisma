// Wanyrix application schema.
//
// The web platform is local-first: the UI's source of truth for scan history
// is per-browser localStorage (src/lib/wanyrix/scan-store.ts). This database
// is the OPTIONAL durable sync target — completed scan runs are fire-and-
// forget POSTed to /api/wanyrix/scan-runs and served back verbatim. The
// server never invents runs, durations, or figures (Gate 21): every row here
// was measured in a real browser session and POSTed by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One completed doctor-scan run, synced from the web client.
/// Shape mirrors `ScanRunRecord` (src/lib/wanyrix/scan-store.ts) key-for-key;
/// `id` is the client's deterministic `run-<seq>-<startedAt>` so retries are
/// idempotent (upsert).
model ScanRun {
  id           String   @id
  workspaceId  String
  startedAt    DateTime // epoch ms from the client, stored as DateTime
  finishedAt   DateTime
  durationMs   Int // measured wall clock (finishedAt − startedAt), client-side
  findingCount Int
  critical     Int
  warning      Int
  info         Int
  trigger      String   @default("manual") // manual | topbar | palette
  syncedAt     DateTime @default(now()) // when the server received it

  // Findings fingerprint (R7): the sorted unique finding ids the run's
  // payload contained, JSON-encoded. Optional — legacy synced runs predate
  // it. Persisted verbatim (Gate 21); diffs are computed client-side.
  findingIds          String? // JSON string[] — sorted, unique, capped at 400
  findingIdsTruncated Boolean @default(false) // true when the source list exceeded the 400 cap

  // Issue #128 (honesty): true when the run REPLAYED the stored doctor report
  // (doctor view / topbar / ⌘K — the engine binary was not invoked by those
  // flows). Persisted verbatim from the client's POST; the server never
  // derives it. Additive + default(false) — pre-existing rows are real
  // engine-exec or legacy runs and simply render without the REPLAY badge.
  replay Boolean @default(false)

  @@index([workspaceId, startedAt])
}

/// A user-registered LOCAL project (the workspace registration bridge).
/// Registration runs the REAL engine (doctor + graph) against the path; the
/// stored counts are what the engine measured — never invented (Gate 21).
model RegisteredWorkspace {
  id            String   @id // deterministic: ws-local-<slug>-<fnv1a8(abs path)>
  name          String   // directory basename
  path          String   // canonical absolute path
  registeredAt  DateTime @default(now())
  lastCheckedAt DateTime // last real engine scan (registration = first check)
  lastStatus    String   // ok | failed
  crates        Int      // measured by the engine
  edges         Int      // measured by the engine (graph aggregates)
  findings      Int
  critical      Int
  warning       Int
  info          Int
  toolchain     String   @default("unknown")
}
